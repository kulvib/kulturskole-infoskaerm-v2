#!/usr/bin/python3
from __future__ import annotations

import argparse
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

from clientflow_bootstrap_common import (  # noqa: E402
    BootstrapError,
    banner,
    KIOSK_USER,
    clear_usb_state,
    configure_network_interactive,
    confirmed_reboot,
    forget_saved_networks,
    install_customer_activation_sudoers,
    install_customer_launcher_trust_helper,
    install_persistent_bootstrap,
    install_terminal_launcher,
    load_factory_state,
    load_usb_state,
    ok,
    phase,
    prepare_factory_bootstrap_user_hidden,
    prepare_factory_graphical_login,
    prompt_client_name_confirmed,
    provision_factory_human_accounts,
    remove_desktop_install_icons,
    require_root,
    sudo_user,
    validate_factory_handoff,
    write_desktop_launcher,
    write_factory_state,
    write_usb_state,
)

FACTORY_LAUNCHER = Path("/usr/local/bin/clientflow-open-factory-prepare")
CUSTOMER_LAUNCHER = Path("/usr/local/bin/clientflow-open-customer-activation")


def _install_factory_launcher(operator: str) -> None:
    install_terminal_launcher(
        FACTORY_LAUNCHER,
        title="01 Klient klargøring",
        command=(
            "sudo /usr/local/lib/clientflow-bootstrap/clientflow-factory-prepare; "
            "rc=$?; echo; if [ $rc -ne 0 ]; then echo \"Klient-klargøring stoppede med fejlkode $rc.\"; fi; "
            "read -r -p \"Tryk Enter for at lukke vinduet...\" _ || true; exit $rc"
        ),
    )
    remove_desktop_install_icons(operator)
    target = write_desktop_launcher(
        operator,
        filename="01 Klient klargøring.desktop",
        name="01 Klient klargøring",
        comment="Fase 1: Klargør ClientFlow-klienten på kontoret",
        exec_path=str(FACTORY_LAUNCHER),
    )
    ok(f"Fase 1 oprettet i aktiv XDG Desktop-mappe: {target}")


def _install_customer_launcher(operator: str) -> None:
    install_terminal_launcher(
        CUSTOMER_LAUNCHER,
        title="02 Aktiver ClientFlow",
        command=(
            "sudo -n /usr/local/lib/clientflow-bootstrap/clientflow-fresh-install; "
            "rc=$?; echo; if [ $rc -ne 0 ]; then echo \"Kundeaktivering stoppede med fejlkode $rc.\"; fi; "
            "read -r -p \"Tryk Enter for at lukke vinduet...\" _ || true; exit $rc"
        ),
    )
    remove_desktop_install_icons(operator)
    write_desktop_launcher(
        operator,
        filename="02 Aktiver ClientFlow.desktop",
        name="02 Aktiver ClientFlow",
        comment="Fase 2: Aktiver klienten manuelt med kundens CF-kode",
        exec_path=str(CUSTOMER_LAUNCHER),
    )


def usb_preflight() -> int:
    require_root()
    operator = sudo_user()
    install_persistent_bootstrap(HERE)
    marker = configure_network_interactive("USB-klargøring")
    write_usb_state(operator_user=operator, network_marker=marker)
    _install_factory_launcher(operator)
    return 0


def factory_prepare() -> int:
    require_root()
    operator = sudo_user()
    install_persistent_bootstrap(HERE)

    banner("01 · Klient-/factory-klargøring · V2 · manuel desktopflow")
    phase("1/6 · Netværkskontrol i factory-fasen")
    usb_state = load_usb_state()
    if usb_state is not None:
        recorded_operator = str(usb_state.get("operator_user") or "")
        if recorded_operator != operator:
            raise BootstrapError("USB-klargøringen tilhører en anden lokal Ubuntu-bruger")
    configure_network_interactive("klient-/factory-klargøring")

    phase("2/6 · Klientnavn, kiosk-bruger og lokal admin")
    previous = load_factory_state()
    existing = str(previous.get("client_name") or "") if previous else None
    client_name = prompt_client_name_confirmed(existing)
    write_factory_state(client_name=client_name, operator_user=operator, handoff_ready=False)
    ok(f"Klientnavn bekræftet: {client_name}")
    ok(f"Kiosk-bruger fastlagt: ClientFlow kiosk user ({KIOSK_USER})")
    provision_factory_human_accounts()

    phase("3/6 · Kiosk-login til kundeoverdragelse")
    prepare_factory_graphical_login()
    prepare_factory_bootstrap_user_hidden(operator)

    phase("4/6 · Skrivebordsikon til kundeaktivering")
    _install_customer_launcher(KIOSK_USER)
    install_customer_launcher_trust_helper(KIOSK_USER)
    install_customer_activation_sudoers()
    remove_desktop_install_icons(operator)
    ok("02 Aktiver ClientFlow er oprettet hos kiosk-brugeren.")

    phase("5/6 · Glem factory-netværk")
    forget_saved_networks()
    clear_usb_state()

    phase("6/6 · Sikkerhedstjek før reboot")
    validate_factory_handoff(client_name=client_name, operator_user=operator)
    ok(
        "Klient klargøring færdig. Maskinen er klar til kundeoverdragelse: klientnavn og cfadmin er defineret, "
        "clientflow-kiosk bliver næste grafiske login, 02 Aktiver ClientFlow ligger på kiosk-skrivebordet, "
        "og gemte kontor-netværksprofiler er fjernet."
    )
    confirmed_reboot("klient klargøring gennemført", seconds=5)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--usb-preflight", action="store_true")
    args = parser.parse_args(argv)
    try:
        return usb_preflight() if args.usb_preflight else factory_prepare()
    except KeyboardInterrupt:
        print("\nAfbrudt.", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"ClientFlow klient-klargøring fejlede: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
