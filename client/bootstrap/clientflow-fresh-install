#!/usr/bin/python3
"""Canonical code-only ClientFlow fresh-install bootstrap.

The short enrollment code is exchanged with the canonical backend for its
already-bound exact release.  First activation is deliberately separate from
installation: installation ends in durable ``pending_manual_activation``. The
helper then materializes the staged release's graphical kiosk-session baseline
before it queues one controlled reboot, so GDM can establish the canonical
``clientflow-kiosk`` Wayland session. A later invocation activates only the
immutable staged release through ``python -P -m clientflow_release``.
"""
from __future__ import annotations

import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request

BACKEND_URL = "https://api.display.planiq.dk"
BOOTSTRAP_ENDPOINT = "/api/enrollment/fresh-install-bootstrap"
DEFAULT_ARTIFACT_ENDPOINT = "/api/enrollment/fresh-install-artifact"
RELEASE_ID_RE = re.compile(r"^clientflow-\d+\.\d+\.\d+-seq-[1-9]\d*$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
MAX_JSON_BYTES = 128 * 1024
INSTALL_STATE = Path("/var/lib/clientflow/release/install-state.json")
RELEASES_ROOT = Path("/opt/clientflow/releases")
KIOSK_USER = "clientflow-kiosk"
LOGINCTL = Path("/usr/bin/loginctl")
SYSTEMCTL = Path("/usr/bin/systemctl")


def _post_json(path: str, body: dict[str, object], *, timeout: int = 30):
    payload = json.dumps(body, separators=(",", ":")).encode("utf-8")
    request = urllib.request.Request(
        BACKEND_URL + path,
        data=payload,
        headers={"Content-Type": "application/json", "Accept": "application/json"},
        method="POST",
    )
    return urllib.request.urlopen(request, timeout=timeout)


def _read_json_response(response) -> dict[str, object]:
    raw = response.read(MAX_JSON_BYTES + 1)
    if len(raw) > MAX_JSON_BYTES:
        raise RuntimeError("Bootstrap-svaret er for stort")
    data = json.loads(raw.decode("utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError("Bootstrap-svaret har forkert format")
    return data


def _binding(data: dict[str, object]) -> dict[str, object]:
    release_id = str(data.get("release_id") or "").strip()
    bundle_sha256 = str(data.get("bundle_sha256") or "").strip().lower()
    authorization = str(data.get("authorization") or "").strip()
    artifact_url = str(data.get("artifact_url") or DEFAULT_ARTIFACT_ENDPOINT).strip()
    try:
        bundle_size = int(data.get("bundle_size"))
    except (TypeError, ValueError) as exc:
        raise RuntimeError("Bootstrap-svaret mangler gyldig bundle-størrelse") from exc
    approval = str(data.get("release_approval_reference") or "").strip()
    if not RELEASE_ID_RE.fullmatch(release_id):
        raise RuntimeError("Bootstrap-svaret mangler gyldig exact release-id")
    if not SHA256_RE.fullmatch(bundle_sha256) or bundle_size < 1:
        raise RuntimeError("Bootstrap-svaret mangler gyldig approved bundle-binding")
    if not authorization or len(authorization) > 4096:
        raise RuntimeError("Bootstrap-svaret mangler signed fresh-install authorization")
    if not artifact_url.startswith("/api/enrollment/") or "://" in artifact_url:
        raise RuntimeError("Bootstrap-svaret har ugyldig artifact-route")
    if not approval:
        raise RuntimeError("Bootstrap-svaret mangler release approval-reference")
    return {
        "release_id": release_id,
        "bundle_sha256": bundle_sha256,
        "bundle_size": bundle_size,
        "authorization": authorization,
        "artifact_url": artifact_url,
        "release_approval_reference": approval,
    }


def _download_exact_bundle(code: str, binding: dict[str, object], directory: Path) -> Path:
    body = {
        "enrollment_code": code,
        "authorization": binding["authorization"],
        "expected_release_id": binding["release_id"],
        "expected_bundle_sha256": binding["bundle_sha256"],
    }
    request = urllib.request.Request(
        BACKEND_URL + str(binding["artifact_url"]),
        data=json.dumps(body, separators=(",", ":")).encode("utf-8"),
        headers={"Content-Type": "application/json", "Accept": "application/octet-stream"},
        method="POST",
    )
    path = directory / "clientflow-approved.tar"
    digest = hashlib.sha256()
    size = 0
    with urllib.request.urlopen(request, timeout=120) as response, path.open("xb") as output:
        while True:
            chunk = response.read(1024 * 1024)
            if not chunk:
                break
            output.write(chunk)
            digest.update(chunk)
            size += len(chunk)
        output.flush()
        os.fsync(output.fileno())
    os.chmod(path, 0o400)
    if size != int(binding["bundle_size"]):
        raise RuntimeError(f"Approved bundle size mismatch: {size}")
    if digest.hexdigest() != binding["bundle_sha256"]:
        raise RuntimeError("Approved bundle SHA-256 mismatch")
    return path


def _materialize_installer(bundle: Path, binding: dict[str, object], directory: Path) -> Path:
    with tarfile.open(bundle, mode="r:*") as archive:
        manifest_member = archive.getmember("manifest.json")
        if not manifest_member.isfile() or manifest_member.size > 1024 * 1024:
            raise RuntimeError("Bundle manifest er ugyldigt")
        manifest_file = archive.extractfile(manifest_member)
        if manifest_file is None:
            raise RuntimeError("Bundle manifest kan ikke læses")
        manifest = json.loads(manifest_file.read().decode("utf-8"))
        if str(manifest.get("release_id") or "") != binding["release_id"]:
            raise RuntimeError("Bundle release-id matcher ikke bootstrap-bindingen")
        fresh = manifest.get("fresh_installer")
        if not isinstance(fresh, dict):
            raise RuntimeError("Bundle mangler embedded fresh installer")
        filename = str(fresh.get("file") or "")
        if not re.fullmatch(r"clientflow-installer-\d+\.\d+\.\d+\.pyz", filename):
            raise RuntimeError("Embedded installer-filnavn er ugyldigt")
        expected_sha = str(fresh.get("sha256") or "").lower()
        try:
            expected_size = int(fresh.get("size"))
        except (TypeError, ValueError) as exc:
            raise RuntimeError("Embedded installer-størrelse er ugyldig") from exc
        if not SHA256_RE.fullmatch(expected_sha) or expected_size < 1:
            raise RuntimeError("Embedded installer-integritet er ugyldig")
        member = archive.getmember(filename)
        if not member.isfile() or member.size != expected_size:
            raise RuntimeError("Embedded installer matcher ikke manifestet")
        source = archive.extractfile(member)
        if source is None:
            raise RuntimeError("Embedded installer kan ikke læses")
        data = source.read(expected_size + 1)
        if len(data) != expected_size or hashlib.sha256(data).hexdigest() != expected_sha:
            raise RuntimeError("Embedded installer SHA-256 mismatch")
    installer = directory / filename
    with installer.open("xb") as output:
        output.write(data)
        output.flush()
        os.fsync(output.fileno())
    os.chmod(installer, 0o500)
    return installer


def _existing_install_state() -> dict[str, object] | None:
    try:
        meta = INSTALL_STATE.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(meta.st_mode) or meta.st_uid != 0 or (meta.st_mode & 0o077):
        raise RuntimeError("Eksisterende ClientFlow install-state har ugyldig ownership/permissions")
    raw = INSTALL_STATE.read_bytes()
    if len(raw) > MAX_JSON_BYTES:
        raise RuntimeError("Eksisterende ClientFlow install-state er for stor")
    data = json.loads(raw.decode("utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError("Eksisterende ClientFlow install-state er ugyldig")
    return data


def _secure_root_regular(path: Path, *, executable: bool = False) -> None:
    try:
        meta = path.lstat()
    except FileNotFoundError as exc:
        raise RuntimeError(f"Canonical staged fil mangler: {path}") from exc
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISREG(meta.st_mode):
        raise RuntimeError(f"Canonical staged fil er ikke en reel fil: {path}")
    if meta.st_uid != 0 or (meta.st_mode & 0o022):
        raise RuntimeError(f"Canonical staged fil har ugyldig ownership/permissions: {path}")
    if executable and not (meta.st_mode & stat.S_IXUSR):
        raise RuntimeError(f"Canonical staged runtime er ikke eksekverbar: {path}")


def _session_properties(session_id: str) -> dict[str, str]:
    result = subprocess.run(
        [str(LOGINCTL), "show-session", session_id,
         "-p", "Name", "-p", "Seat", "-p", "Remote", "-p", "Type", "-p", "Active"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=5,
        check=False,
    )
    if result.returncode != 0:
        return {}
    props: dict[str, str] = {}
    for line in result.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep:
            props[key] = value
    return props


def _canonical_kiosk_session() -> str | None:
    result = subprocess.run(
        [str(LOGINCTL), "list-sessions", "--no-legend"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=5,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Kan ikke læse logind-sessioner før activation")
    for line in result.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        session_id = fields[0]
        props = _session_properties(session_id)
        if (
            props.get("Name") == KIOSK_USER
            and props.get("Seat") == "seat0"
            and props.get("Remote") == "no"
            and props.get("Type") == "wayland"
        ):
            return session_id
    return None


def _prepare_kiosk_session_for_activation() -> None:
    """Require and foreground the post-reboot canonical kiosk Wayland session."""
    if not LOGINCTL.is_file():
        raise RuntimeError("loginctl mangler; kan ikke etablere canonical kiosk-session")
    session_id = _canonical_kiosk_session()
    if session_id is None:
        raise RuntimeError(
            "Canonical clientflow-kiosk Wayland-session mangler. "
            "Fresh install skal gennemføre den kontrollerede reboot før activation; "
            "brug derefter brugerskift til cfadmin uden at logge kiosk-sessionen ud."
        )
    props = _session_properties(session_id)
    if props.get("Active") != "yes":
        subprocess.run([str(LOGINCTL), "unlock-session", session_id], check=False, timeout=5)
        result = subprocess.run([str(LOGINCTL), "activate", session_id], check=False, timeout=5)
        if result.returncode != 0:
            raise RuntimeError("Kunne ikke gøre canonical kiosk-session aktiv på seat0")
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            if _session_properties(session_id).get("Active") == "yes":
                break
            time.sleep(0.5)
        else:
            raise RuntimeError("Canonical kiosk-session blev ikke aktiv på seat0 inden activation")


def _prepare_pre_activation_graphical_session() -> None:
    """Materialize only the staged graphical kiosk-session baseline before reboot."""
    state = _existing_install_state()
    if not isinstance(state, dict) or state.get("status") != "pending_manual_activation":
        raise RuntimeError("Grafisk pre-activation preparation afvist: durable pending state mangler")
    binding = state.get("fresh_install_binding")
    if not isinstance(binding, dict):
        raise RuntimeError("Grafisk pre-activation preparation afvist: exact release-binding mangler")
    release_id = str(binding.get("release_id") or "").strip()
    if not RELEASE_ID_RE.fullmatch(release_id):
        raise RuntimeError("Grafisk pre-activation preparation afvist: release-id er ugyldig")

    release_root = RELEASES_ROOT / release_id
    if release_root.parent != RELEASES_ROOT or not release_root.is_dir() or release_root.is_symlink():
        raise RuntimeError("Grafisk pre-activation preparation mangler canonical staged release")
    runtime_python = release_root / "runtime/bin/python"
    session_prepare = (
        release_root
        / "runtime/lib/python3.13/site-packages/clientflow_runtime/display_session_prepare.py"
    )
    _secure_root_regular(runtime_python, executable=True)
    _secure_root_regular(session_prepare)

    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1",
        "CLIENTFLOW_KIOSK_USER": KIOSK_USER,
    }
    result = subprocess.run(
        [str(runtime_python), "-P", "-m", "clientflow_runtime.display_session_prepare"],
        env=env,
        check=False,
        timeout=120,
    )
    if result.returncode != 0:
        raise RuntimeError("Canonical grafisk kiosk-session baseline kunne ikke materialiseres")


def _canonical_staged_activation(release_id: str, approval: str) -> int:
    release_root = RELEASES_ROOT / release_id
    if release_root.parent != RELEASES_ROOT or not release_root.is_dir() or release_root.is_symlink():
        raise RuntimeError("Pending installation mangler canonical staged release")
    runtime_python = release_root / "runtime/bin/python"
    package_init = release_root / "release/lib/clientflow_release/__init__.py"
    _secure_root_regular(runtime_python, executable=True)
    _secure_root_regular(package_init)
    _prepare_kiosk_session_for_activation()
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": str(release_root / "release/lib"),
    }
    result = subprocess.run(
        [
            str(runtime_python), "-P", "-m", "clientflow_release", "activate",
            "--release-id", release_id,
            "--expected-release-approval-reference", approval,
        ],
        env=env,
        check=False,
    )
    return int(result.returncode)


def _activate_pending(state: dict[str, object]) -> int | None:
    status = str(state.get("status") or "")
    if status == "activated":
        print("ClientFlow er allerede aktiveret.")
        return 0
    if status != "pending_manual_activation":
        return None
    binding = state.get("fresh_install_binding")
    if not isinstance(binding, dict):
        raise RuntimeError("Pending installation mangler exact release-binding")
    release_id = str(binding.get("release_id") or "").strip()
    approval = str(binding.get("release_approval_reference") or "").strip()
    if not RELEASE_ID_RE.fullmatch(release_id) or not approval:
        raise RuntimeError("Pending installation har ugyldig exact release-binding")
    if _canonical_kiosk_session() is None:
        _prepare_pre_activation_graphical_session()
        _queue_controlled_pre_activation_reboot()
        return 0
    return _canonical_staged_activation(release_id, approval)


def _queue_controlled_pre_activation_reboot() -> None:
    """Queue exactly one reboot after durable pending state exists."""
    state = _existing_install_state()
    if not isinstance(state, dict) or state.get("status") != "pending_manual_activation":
        raise RuntimeError("Kontrolleret reboot afvist: durable pending_manual_activation mangler")
    binding = state.get("fresh_install_binding")
    if not isinstance(binding, dict) or not RELEASE_ID_RE.fullmatch(str(binding.get("release_id") or "")):
        raise RuntimeError("Kontrolleret reboot afvist: pending exact release-binding mangler")
    result = subprocess.run([str(SYSTEMCTL), "--no-block", "--ignore-inhibitors", "reboot"], check=False, timeout=10)
    if result.returncode != 0:
        raise RuntimeError("Kunne ikke køe den kontrollerede pre-activation reboot")
    print("ClientFlow installation er staged. Klienten genstarter for at etablere kiosk-sessionen før manuel activation.")


def _prompt(label: str, *, required: bool = False) -> str:
    while True:
        value = input(label).strip()
        if value or not required:
            return value
        print("Værdien må ikke være tom.", file=sys.stderr)


def main() -> int:
    if os.geteuid() != 0:
        print("Aktiver ClientFlow skal køres med administratorrettigheder.", file=sys.stderr)
        return 2
    try:
        existing = _existing_install_state()
        if existing is not None:
            activation_result = _activate_pending(existing)
            if activation_result is not None:
                return activation_result
    except Exception as exc:
        print(f"ClientFlow activation check fejlede: {exc}", file=sys.stderr)
        return 1

    code = getpass.getpass("CF-kode: ").strip().upper()
    if not code:
        print("CF-kode mangler.", file=sys.stderr)
        return 2
    name = _prompt("Klientnavn: ", required=True)
    locality = _prompt("Lokation (valgfri): ")
    network_uuid = _prompt("Midlertidig bootstrap-netværksprofil UUID (valgfri): ")

    try:
        with _post_json(BOOTSTRAP_ENDPOINT, {"enrollment_code": code}) as response:
            binding = _binding(_read_json_response(response))
        with tempfile.TemporaryDirectory(prefix="clientflow-fresh-install.", dir="/run") as tmp:
            directory = Path(tmp)
            os.chmod(directory, 0o700)
            bundle = _download_exact_bundle(code, binding, directory)
            installer = _materialize_installer(bundle, binding, directory)
            command = [
                sys.executable, "-I", str(installer), "install",
                "--bundle", str(bundle),
                "--expected-bundle-sha256", str(binding["bundle_sha256"]),
                "--backend-url", BACKEND_URL,
                "--fresh-install-authority-stdin",
                "--name", name,
            ]
            if locality:
                command += ["--locality", locality]
            if network_uuid:
                command += ["--bootstrap-network-connection-uuid", network_uuid]
            authorities = f"{code}\n{binding['authorization']}\n".encode("utf-8")
            result = subprocess.run(command, input=authorities, check=False)
            if result.returncode != 0:
                return int(result.returncode)
            _prepare_pre_activation_graphical_session()
            _queue_controlled_pre_activation_reboot()
            return 0
    except urllib.error.HTTPError as exc:
        try:
            detail = json.loads(exc.read().decode("utf-8")).get("detail")
        except Exception:
            detail = None
        print(str(detail or f"Backend afviste bootstrap ({exc.code})"), file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"ClientFlow fresh install fejlede: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
