BACKEND_URL = "https://api.display.planiq.dk"
BOOTSTRAP_ENDPOINT = "/api/enrollment/fresh-install-bootstrap"
DEFAULT_ARTIFACT_ENDPOINT = "/api/enrollment/fresh-install-artifact"
RELEASE_ID_RE = re.compile(r"^clientflow-\d+\.\d+\.\d+-seq-[1-9]\d*$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
MAX_JSON_BYTES = 128 * 1024
INSTALL_STATE = Path("/var/lib/clientflow/release/install-state.json")
RELEASES_ROOT = Path("/opt/clientflow/releases")
KIOSK_USER = "clientflow-kiosk"
LOGINCTL = Path("/usr/bin/loginctl")
SYSTEMCTL = Path("/usr/bin/systemctl")
PENDING_BUNDLE = BOOTSTRAP_ROOT / "pending-approved-bundle.tar"
PREACTIVATION_GUI_UNIT = Path("/etc/systemd/system/clientflow-preactivation-gui.service")
PREACTIVATION_GUI_SERVICE = "clientflow-preactivation-gui.service"
SYSTEM_PYTHON = Path("/usr/bin/python3")
FIRST_CLAIM_REJECTED_EXIT = 20
APPROVAL_READINESS_ENDPOINT = "/api/client-auth/approval-readiness"
STATUS_CREDENTIAL = Path("/etc/clientflow/credentials/status.json")
BOOT_ID_PATH = Path("/proc/sys/kernel/random/boot_id")
REBOOT_REQUIRED_PATH = Path("/var/run/reboot-required")
APT_GET = Path("/usr/bin/apt-get")
DPKG = Path("/usr/bin/dpkg")
BOOTSTRAP_LAUNCHERS = (
    Path("/usr/local/bin/clientflow-open-factory-prepare"),
    Path("/usr/local/bin/clientflow-open-customer-activation"),
)
BOOTSTRAP_FILES = (
    "clientflow_bootstrap_common.py",
    "clientflow-factory-prepare",
    "clientflow-fresh-install",
    "planiq-display-mark.png",
)


def _post_json(path: str, body: dict[str, object], *, timeout: int = 30):
    payload = json.dumps(body, separators=(",", ":")).encode("utf-8")
    request = urllib.request.Request(
        BACKEND_URL + path,
        data=payload,
        headers={"Content-Type": "application/json", "Accept": "application/json"},
        method="POST",
    )
    return urllib.request.urlopen(request, timeout=timeout)


def _read_json_response(response) -> dict[str, object]:
    raw = response.read(MAX_JSON_BYTES + 1)
    if len(raw) > MAX_JSON_BYTES:
        raise RuntimeError("Bootstrap-svaret er for stort")
    data = json.loads(raw.decode("utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError("Bootstrap-svaret har forkert format")
    return data


def _binding(data: dict[str, object]) -> dict[str, object]:
    release_id = str(data.get("release_id") or "").strip()
    bundle_sha256 = str(data.get("bundle_sha256") or "").strip().lower()
    authorization = str(data.get("authorization") or "").strip()
    artifact_url = str(data.get("artifact_url") or DEFAULT_ARTIFACT_ENDPOINT).strip()
    try:
        bundle_size = int(data.get("bundle_size"))
    except (TypeError, ValueError) as exc:
        raise RuntimeError("Bootstrap-svaret mangler gyldig bundle-størrelse") from exc
    approval = str(data.get("release_approval_reference") or "").strip()
    if not RELEASE_ID_RE.fullmatch(release_id):
        raise RuntimeError("Bootstrap-svaret mangler gyldig exact release-id")
    if not SHA256_RE.fullmatch(bundle_sha256) or bundle_size < 1:
        raise RuntimeError("Bootstrap-svaret mangler gyldig approved bundle-binding")
    if not authorization or len(authorization) > 4096:
        raise RuntimeError("Bootstrap-svaret mangler signed fresh-install authorization")
    if not artifact_url.startswith("/api/enrollment/") or "://" in artifact_url:
        raise RuntimeError("Bootstrap-svaret har ugyldig artifact-route")
    if not approval:
        raise RuntimeError("Bootstrap-svaret mangler release approval-reference")
    return {
        "release_id": release_id,
        "bundle_sha256": bundle_sha256,
        "bundle_size": bundle_size,
        "authorization": authorization,
        "artifact_url": artifact_url,
        "release_approval_reference": approval,
    }


def _download_exact_bundle(code: str, binding: dict[str, object], directory: Path) -> Path:
    body = {
        "enrollment_code": code,
        "authorization": binding["authorization"],
        "expected_release_id": binding["release_id"],
        "expected_bundle_sha256": binding["bundle_sha256"],
    }
    request = urllib.request.Request(
        BACKEND_URL + str(binding["artifact_url"]),
        data=json.dumps(body, separators=(",", ":")).encode("utf-8"),
        headers={"Content-Type": "application/json", "Accept": "application/octet-stream"},
        method="POST",
    )
    path = directory / "clientflow-approved.tar"
    digest = hashlib.sha256()
    size = 0
    expected_size = int(binding["bundle_size"])
    next_report = 0
    print(f"Henter exact approved release: {binding['release_id']} ({expected_size} bytes)", flush=True)
    with urllib.request.urlopen(request, timeout=120) as response, path.open("xb") as output:
        while True:
            chunk = response.read(1024 * 1024)
            if not chunk:
                break
            output.write(chunk)
            digest.update(chunk)
            size += len(chunk)
            if size >= next_report or size == expected_size:
                percent = min(100, int((size * 100) / expected_size)) if expected_size else 0
                print(f"  download: {size}/{expected_size} bytes ({percent}%)", flush=True)
                next_report = size + 16 * 1024 * 1024
        output.flush()
        os.fsync(output.fileno())
    os.chmod(path, 0o400)
    if size != expected_size:
        raise RuntimeError(f"Approved bundle size mismatch: {size}")
    if digest.hexdigest() != binding["bundle_sha256"]:
        raise RuntimeError("Approved bundle SHA-256 mismatch")
    print("  download: exact størrelse og SHA-256 verificeret.", flush=True)
    return path



def _clear_cached_bundle() -> None:
    PENDING_BUNDLE.unlink(missing_ok=True)


def _cache_exact_bundle(bundle: Path, binding: dict[str, object]) -> Path:
    """Persist only the already-verified exact bundle needed for safe claim resume."""
    BOOTSTRAP_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chown(BOOTSTRAP_ROOT, 0, 0)
    os.chmod(BOOTSTRAP_ROOT, 0o700)
    expected_size = int(binding["bundle_size"])
    expected_sha = str(binding["bundle_sha256"])
    fd, temporary_name = tempfile.mkstemp(prefix=".pending-approved-bundle.", dir=str(BOOTSTRAP_ROOT))
    temporary = Path(temporary_name)
    digest = hashlib.sha256()
    size = 0
    try:
        os.fchmod(fd, 0o400)
        with bundle.open("rb") as source, os.fdopen(fd, "wb", closefd=True) as output:
            while True:
                chunk = source.read(1024 * 1024)
                if not chunk:
                    break
                output.write(chunk)
                digest.update(chunk)
                size += len(chunk)
            output.flush()
            os.fsync(output.fileno())
        if size != expected_size or digest.hexdigest() != expected_sha:
            raise RuntimeError("Cached approved bundle matcher ikke exact bootstrap-binding")
        os.chown(temporary, 0, 0)
        os.chmod(temporary, 0o400)
        os.replace(temporary, PENDING_BUNDLE)
        directory_fd = os.open(BOOTSTRAP_ROOT, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)
    return PENDING_BUNDLE


def _cached_exact_bundle(binding: dict[str, object]) -> Path:
    try:
        meta = PENDING_BUNDLE.lstat()
    except FileNotFoundError as exc:
        raise RuntimeError(
            "Uafsluttet fresh install mangler den exact approved bundle, som kræves for sikker resume"
        ) from exc
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISREG(meta.st_mode):
        raise RuntimeError("Cached approved bundle er ikke en reel fil")
    if meta.st_uid != 0 or (meta.st_mode & 0o077):
        raise RuntimeError("Cached approved bundle har ugyldig ownership/permissions")
    expected_size = int(binding.get("bundle_size") or 0)
    expected_sha = str(binding.get("bundle_sha256") or "").strip().lower()
    if meta.st_size != expected_size or not SHA256_RE.fullmatch(expected_sha):
        raise RuntimeError("Cached approved bundle matcher ikke pending fresh-install binding")
    digest = hashlib.sha256()
    with PENDING_BUNDLE.open("rb") as source:
        while chunk := source.read(1024 * 1024):
            digest.update(chunk)
    if digest.hexdigest() != expected_sha:
        raise RuntimeError("Cached approved bundle SHA-256 matcher ikke pending fresh-install binding")
    return PENDING_BUNDLE


def _resume_binding(state: dict[str, object]) -> dict[str, object]:
    binding = state.get("fresh_install_binding")
    if not isinstance(binding, dict):
        raise RuntimeError("Uafsluttet fresh install mangler exact release-binding")
    release_id = str(binding.get("release_id") or "").strip()
    sha = str(binding.get("bundle_sha256") or "").strip().lower()
    try:
        size = int(binding.get("bundle_size"))
    except (TypeError, ValueError) as exc:
        raise RuntimeError("Uafsluttet fresh install har ugyldig bundle-størrelse") from exc
    if not RELEASE_ID_RE.fullmatch(release_id) or not SHA256_RE.fullmatch(sha) or size < 1:
        raise RuntimeError("Uafsluttet fresh install har ugyldig exact release-binding")
    return dict(binding)


def _run_canonical_installer(
    *,
    bundle: Path,
    binding: dict[str, object],
    name: str,
    locality: str | None,
    authorities: bytes | None,
) -> int:
    with tempfile.TemporaryDirectory(prefix="clientflow-installer.", dir="/run") as tmp:
        installer = _materialize_installer(bundle, binding, Path(tmp))
        command = [
            sys.executable,
            "-I",
            str(installer),
            "install",
            "--bundle",
            str(bundle),
            "--expected-bundle-sha256",
            str(binding["bundle_sha256"]),
            "--backend-url",
            BACKEND_URL,
            "--name",
            name,
            "--factory-state",
            str(FACTORY_STATE),
        ]
        if authorities is not None:
            command.append("--fresh-install-authority-stdin")
        command.append("--suppress-result-json")
        if locality:
            command += ["--locality", locality]
        print("Starter canonical ClientFlow fresh-installer. Installationslinjer vises løbende nedenfor.", flush=True)
        return int(subprocess.run(command, input=authorities, check=False).returncode)

def _materialize_installer(bundle: Path, binding: dict[str, object], directory: Path) -> Path:
    print("Verificerer embedded canonical fresh-installer i approved bundle...", flush=True)
    with tarfile.open(bundle, mode="r:*") as archive:
        manifest_member = archive.getmember("manifest.json")
        if not manifest_member.isfile() or manifest_member.size > 1024 * 1024:
            raise RuntimeError("Bundle manifest er ugyldigt")
        manifest_file = archive.extractfile(manifest_member)
        if manifest_file is None:
            raise RuntimeError("Bundle manifest kan ikke læses")
        manifest = json.loads(manifest_file.read().decode("utf-8"))
        if str(manifest.get("release_id") or "") != binding["release_id"]:
            raise RuntimeError("Bundle release-id matcher ikke bootstrap-bindingen")
        fresh = manifest.get("fresh_installer")
        if not isinstance(fresh, dict):
            raise RuntimeError("Bundle mangler embedded fresh installer")
        filename = str(fresh.get("file") or "")
        if not re.fullmatch(r"clientflow-installer-\d+\.\d+\.\d+\.pyz", filename):
            raise RuntimeError("Embedded installer-filnavn er ugyldigt")
        expected_sha = str(fresh.get("sha256") or "").lower()
        try:
            expected_size = int(fresh.get("size"))
        except (TypeError, ValueError) as exc:
            raise RuntimeError("Embedded installer-størrelse er ugyldig") from exc
        if not SHA256_RE.fullmatch(expected_sha) or expected_size < 1:
            raise RuntimeError("Embedded installer-integritet er ugyldig")
        member = archive.getmember(filename)
        if not member.isfile() or member.size != expected_size:
            raise RuntimeError("Embedded installer matcher ikke manifestet")
        source = archive.extractfile(member)
        if source is None:
            raise RuntimeError("Embedded installer kan ikke læses")
        data = source.read(expected_size + 1)
        if len(data) != expected_size or hashlib.sha256(data).hexdigest() != expected_sha:
            raise RuntimeError("Embedded installer SHA-256 mismatch")
    installer = directory / filename
    with installer.open("xb") as output:
        output.write(data)
        output.flush()
        os.fsync(output.fileno())
    os.chmod(installer, 0o500)
    print(f"  installer: {filename} · SHA-256 OK · størrelse OK", flush=True)
    return installer


def _existing_install_state() -> dict[str, object] | None:
    try:
        meta = INSTALL_STATE.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(meta.st_mode) or meta.st_uid != 0 or (meta.st_mode & 0o077):
        raise RuntimeError("Eksisterende ClientFlow install-state har ugyldig ownership/permissions")
    raw = INSTALL_STATE.read_bytes()
    if len(raw) > MAX_JSON_BYTES:
        raise RuntimeError("Eksisterende ClientFlow install-state er for stor")
    data = json.loads(raw.decode("utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError("Eksisterende ClientFlow install-state er ugyldig")
    return data


def _secure_root_regular(path: Path, *, executable: bool = False) -> None:
    try:
        meta = path.lstat()
    except FileNotFoundError as exc:
        raise RuntimeError(f"Canonical staged fil mangler: {path}") from exc
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISREG(meta.st_mode):
        raise RuntimeError(f"Canonical staged fil er ikke en reel fil: {path}")
    if meta.st_uid != 0 or (meta.st_mode & 0o022):
        raise RuntimeError(f"Canonical staged fil har ugyldig ownership/permissions: {path}")
    if executable and not (meta.st_mode & stat.S_IXUSR):
        raise RuntimeError(f"Canonical staged runtime er ikke eksekverbar: {path}")


def _session_properties(session_id: str) -> dict[str, str]:
    result = subprocess.run(
        [str(LOGINCTL), "show-session", session_id,
         "-p", "Name", "-p", "Seat", "-p", "Remote", "-p", "Type", "-p", "Active"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=5,
        check=False,
    )
    if result.returncode != 0:
        return {}
    props: dict[str, str] = {}
    for line in result.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep:
            props[key] = value
    return props


def _canonical_kiosk_session() -> str | None:
    result = subprocess.run(
        [str(LOGINCTL), "list-sessions", "--no-legend"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=5,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError("Kan ikke læse logind-sessioner før activation")
    for line in result.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        session_id = fields[0]
        props = _session_properties(session_id)
        if (
            props.get("Name") == KIOSK_USER
            and props.get("Seat") == "seat0"
            and props.get("Remote") == "no"
            and props.get("Type") == "wayland"
        ):
            return session_id
    return None


def _prepare_kiosk_session_for_activation() -> None:
    """Require and foreground the post-reboot canonical kiosk Wayland session."""
    if not LOGINCTL.is_file():
        raise RuntimeError("loginctl mangler; kan ikke etablere canonical kiosk-session")
    session_id = _canonical_kiosk_session()
    if session_id is None:
        raise RuntimeError(
            "Canonical clientflow-kiosk Wayland-session mangler. "
            "Fresh install skal gennemføre den kontrollerede reboot før activation; "
            "brug derefter brugerskift til cfadmin uden at logge kiosk-sessionen ud."
        )
    props = _session_properties(session_id)
    if props.get("Active") != "yes":
        subprocess.run([str(LOGINCTL), "unlock-session", session_id], check=False, timeout=5)
        result = subprocess.run([str(LOGINCTL), "activate", session_id], check=False, timeout=5)
        if result.returncode != 0:
            raise RuntimeError("Kunne ikke gøre canonical kiosk-session aktiv på seat0")
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            if _session_properties(session_id).get("Active") == "yes":
                break
            time.sleep(0.5)
        else:
            raise RuntimeError("Canonical kiosk-session blev ikke aktiv på seat0 inden activation")


def _prepare_pre_activation_graphical_session() -> None:
    """Materialize only the staged graphical kiosk-session baseline before reboot."""
    state = _existing_install_state()
    if not isinstance(state, dict) or state.get("status") != "pending_manual_activation":
        raise RuntimeError("Grafisk pre-activation preparation afvist: durable pending state mangler")
    binding = state.get("fresh_install_binding")
    if not isinstance(binding, dict):
        raise RuntimeError("Grafisk pre-activation preparation afvist: exact release-binding mangler")
    release_id = str(binding.get("release_id") or "").strip()
    if not RELEASE_ID_RE.fullmatch(release_id):
        raise RuntimeError("Grafisk pre-activation preparation afvist: release-id er ugyldig")

    release_root = RELEASES_ROOT / release_id
    if release_root.parent != RELEASES_ROOT or not release_root.is_dir() or release_root.is_symlink():
        raise RuntimeError("Grafisk pre-activation preparation mangler canonical staged release")
    runtime_python = release_root / "runtime/bin/python"
    session_prepare = (
        release_root
        / "runtime/lib/python3.13/site-packages/clientflow_runtime/display_session_prepare.py"
    )
    _secure_root_regular(runtime_python, executable=True)
    _secure_root_regular(session_prepare)

    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1",
        "CLIENTFLOW_KIOSK_USER": KIOSK_USER,
    }
    result = subprocess.run(
        [str(runtime_python), "-P", "-m", "clientflow_runtime.display_session_prepare"],
        env=env,
        check=False,
        timeout=120,
    )
    if result.returncode != 0:
        raise RuntimeError("Canonical grafisk kiosk-session baseline kunne ikke materialiseres")


def _pending_staged_release() -> tuple[dict[str, object], str, Path]:
    state = _existing_install_state()
    if not isinstance(state, dict):
        raise RuntimeError("Pre-activation GUI mangler install-state")
    if state.get("status") != "pending_manual_activation":
        raise RuntimeError("Pre-activation GUI kræver pending_manual_activation")
    binding = state.get("fresh_install_binding")
    if not isinstance(binding, dict):
        raise RuntimeError("Pre-activation GUI mangler exact release-binding")
    release_id = str(binding.get("release_id") or "").strip()
    if not RELEASE_ID_RE.fullmatch(release_id):
        raise RuntimeError("Pre-activation GUI har ugyldig release-id")
    release_root = RELEASES_ROOT / release_id
    if release_root.parent != RELEASES_ROOT or not release_root.is_dir() or release_root.is_symlink():
        raise RuntimeError("Pre-activation GUI mangler canonical staged release")
    if os.path.lexists("/opt/clientflow/active"):
        raise RuntimeError("Pre-activation GUI må ikke køre med active release-symlink")
    return state, release_id, release_root


def _wait_for_kiosk_wayland_socket(uid: int, *, timeout: float = 180.0) -> tuple[str, Path]:
    runtime_dir = Path(f"/run/user/{uid}")
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        current = _existing_install_state()
        if not isinstance(current, dict) or current.get("status") != "pending_manual_activation":
            raise RuntimeError("Pre-activation GUI er ikke længere i pending state")
        try:
            session_id = _canonical_kiosk_session()
        except RuntimeError:
            session_id = None
        if session_id is not None and _session_properties(session_id).get("Active") == "yes":
            try:
                candidates = sorted(runtime_dir.glob("wayland-*"))
            except OSError:
                candidates = []
            for candidate in candidates:
                if candidate.name.endswith(".lock"):
                    continue
                try:
                    meta = candidate.stat()
                except OSError:
                    continue
                if stat.S_ISSOCK(meta.st_mode) and meta.st_uid == uid:
                    return session_id, candidate
        time.sleep(1.0)
    raise RuntimeError("Canonical kiosk Wayland-socket blev ikke klar til pre-activation GUI")


def _preactivation_gui() -> int:
    """Exec the staged release's existing local GUI as kiosk in status-only mode."""
    require_root()
    existing = _existing_install_state()
    if isinstance(existing, dict) and existing.get("status") == "activated":
        return 0
    _state, _release_id, release_root = _pending_staged_release()
    local_gui = release_root / "client-runtime/libexec/local-gui"
    version_path = release_root / "VERSION"
    _secure_root_regular(local_gui, executable=True)
    _secure_root_regular(version_path)
    try:
        system_python_target = SYSTEM_PYTHON.resolve(strict=True)
    except OSError as exc:
        raise RuntimeError("Ubuntu system-Python mangler til pre-activation GUI") from exc
    _secure_root_regular(system_python_target, executable=True)
    try:
        account = pwd.getpwnam(KIOSK_USER)
    except KeyError as exc:
        raise RuntimeError("Canonical kioskbruger mangler til pre-activation GUI") from exc
    if account.pw_uid == 0 or account.pw_gid == 0:
        raise RuntimeError("Canonical kioskbruger må ikke være root")

    _session_id, wayland_socket = _wait_for_kiosk_wayland_socket(account.pw_uid)
    runtime_dir = wayland_socket.parent
    gui_root = Path("/var/lib/clientflow/preactivation-gui")
    gui_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    xdg: dict[str, Path] = {}
    for name in ("cache", "config", "data"):
        directory = gui_root / name
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        xdg[name] = directory
    # The service deliberately lacks CAP_DAC_OVERRIDE and CAP_FOWNER.  Keep the
    # whole tree root-owned while normalizing modes, then transfer children and
    # finally the 0700 parent.  Reclaiming root ownership first also makes this
    # idempotent after a power-loss/restart that stopped mid-transfer.
    directories = (gui_root, *xdg.values())
    for directory in directories:
        os.chown(directory, 0, 0)
        os.chmod(directory, 0o700)
    for directory in (*xdg.values(), gui_root):
        os.chown(directory, account.pw_uid, account.pw_gid)

    environment = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "HOME": account.pw_dir,
        "USER": KIOSK_USER,
        "LOGNAME": KIOSK_USER,
        "XDG_RUNTIME_DIR": str(runtime_dir),
        "XDG_SESSION_TYPE": "wayland",
        "WAYLAND_DISPLAY": wayland_socket.name,
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime_dir / 'bus'}",
        "GDK_BACKEND": "wayland",
        "XDG_CACHE_HOME": str(xdg["cache"]),
        "XDG_CONFIG_HOME": str(xdg["config"]),
        "XDG_DATA_HOME": str(xdg["data"]),
