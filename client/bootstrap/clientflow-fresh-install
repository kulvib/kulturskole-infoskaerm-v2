        except (FileNotFoundError, OSError):
            # Never broaden cleanup to unknown files/directories.
            pass


def _secure_root_json(path: Path, *, max_bytes: int = MAX_JSON_BYTES) -> dict[str, object]:
    try:
        meta = path.lstat()
    except FileNotFoundError as exc:
        raise RuntimeError(f"Canonical root-state mangler: {path}") from exc
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISREG(meta.st_mode):
        raise RuntimeError(f"Canonical root-state er ikke en reel fil: {path}")
    if meta.st_uid != 0 or (meta.st_mode & 0o077):
        raise RuntimeError(f"Canonical root-state har usikre ownership/permissions: {path}")
    raw = path.read_bytes()
    if len(raw) > max_bytes:
        raise RuntimeError(f"Canonical root-state er for stor: {path}")
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Canonical root-state er ugyldig JSON: {path}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"Canonical root-state skal være et JSON-objekt: {path}")
    return value


def _current_boot_id() -> str:
    try:
        value = BOOT_ID_PATH.read_text(encoding="ascii").strip()
    except OSError as exc:
        raise RuntimeError("Kan ikke læse kernel boot-id") from exc
    if not re.fullmatch(r"[0-9a-f-]{36}", value):
        raise RuntimeError("Kernel boot-id har ugyldigt format")
    return value


def _post_reboot_package_manager_healthy() -> bool:
    if REBOOT_REQUIRED_PATH.exists():
        return False
    audit = subprocess.run(
        [str(DPKG), "--audit"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=120,
        check=False,
    )
    if audit.returncode != 0 or (audit.stdout or "").strip():
        return False
    check = subprocess.run(
        [str(APT_GET), "-o", "DPkg::Lock::Timeout=120", "check"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=180,
        check=False,
    )
    return check.returncode == 0


