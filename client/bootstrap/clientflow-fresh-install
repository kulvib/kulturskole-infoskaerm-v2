        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "active"


def _publish_post_reboot_approval_readiness(state: dict[str, object]) -> None:
    preclaim_boot_id = str(state.get("preclaim_boot_id") or "").strip()
    preclaim = state.get("preclaim_host_readiness")
    if not re.fullmatch(r"[0-9a-f-]{36}", preclaim_boot_id):
        raise RuntimeError("Pending install-state mangler gyldigt preclaim boot-id")
    if not isinstance(preclaim, dict):
        raise RuntimeError("Pending install-state mangler preclaim host-readiness")
    required_preclaim = (
        "package_index_refreshed",
        "package_upgrade_completed",
        "dpkg_audit_clean",
        "apt_check_clean",
    )
    if any(preclaim.get(key) is not True for key in required_preclaim):
        raise RuntimeError("Preclaim Ubuntu update/readiness er ikke dokumenteret som gennemført")

    boot_id = _current_boot_id()
    if boot_id == preclaim_boot_id:
        raise RuntimeError("Post-reboot approval-readiness afventer den kontrollerede reboot")
    if _canonical_kiosk_session() is None:
        raise RuntimeError("Post-reboot approval-readiness afventer canonical kiosk Wayland-session")
    if not _preactivation_gui_active():
        raise RuntimeError("Post-reboot approval-readiness afventer synlig preactivation-GUI")
    if not _post_reboot_package_manager_healthy():
        raise RuntimeError("Post-reboot Ubuntu package-state er ikke klar eller kræver endnu en reboot")

    credential = _secure_root_json(STATUS_CREDENTIAL)
    if credential.get("schema_version") != 1 or credential.get("domain") != "status":
        raise RuntimeError("Status credential kan ikke bruges til approval-readiness")
    body = {
        "client_id": int(credential.get("client_id") or 0),
        "credential_id": str(credential.get("credential_id") or ""),
        "client_secret": str(credential.get("client_secret") or ""),
        "preclaim_boot_id": preclaim_boot_id,
        "boot_id": boot_id,
        "kiosk_session_ready": True,
        "preactivation_gui_ready": True,
        "package_manager_healthy": True,
        "post_reboot_reboot_required": False,
    }
    with _post_json(APPROVAL_READINESS_ENDPOINT, body, timeout=30) as response:
        result = _read_json_response(response)
    if result.get("approval_ready") is not True or int(result.get("client_id") or 0) != body["client_id"]:
        raise RuntimeError("Backend kvitterede ikke gyldigt for post-reboot approval-readiness")


def _activation_wait() -> int:
    require_root()
    print("ClientFlow afventer backend-godkendelse og aktiverer automatisk, når approval-proof er gyldigt.")
    while True:
        state = _existing_install_state()
        if state is None:
            print("ClientFlow first-activation state mangler.", file=sys.stderr)
            return 1
        status = str(state.get("status") or "")
        if status == "activated":
            _cleanup_completed_bootstrap()
            return 0
        if status != "pending_manual_activation":
            print(f"ClientFlow first-activation har uventet state: {status}", file=sys.stderr)
            return 1
        binding = state.get("fresh_install_binding")
        if not isinstance(binding, dict):
            print("Pending installation mangler exact release-binding.", file=sys.stderr)
            return 1
        release_id = str(binding.get("release_id") or "").strip()
        approval = str(binding.get("release_approval_reference") or "").strip()
        if not RELEASE_ID_RE.fullmatch(release_id) or not approval:
            print("Pending installation har ugyldig exact release-binding.", file=sys.stderr)
            return 1
        if _canonical_kiosk_session() is None:
            print("ClientFlow afventer canonical clientflow-kiosk Wayland-session.")
            time.sleep(10)
            continue
        try:
            _publish_post_reboot_approval_readiness(state)
        except Exception as exc:
            _ensure_preactivation_gui_started()
            print(f"ClientFlow afventer post-reboot approval-readiness: {exc}", file=sys.stderr)
            time.sleep(10)
            continue
        try:
            result = _canonical_staged_activation(release_id, approval)
        except Exception as exc:
            _ensure_preactivation_gui_started()
            print(f"ClientFlow activation er endnu ikke klar: {exc}", file=sys.stderr)
            time.sleep(10)
            continue
        if result == 0:
            updated = _existing_install_state()
            if isinstance(updated, dict) and updated.get("status") == "activated":
                _cleanup_completed_bootstrap()
                print("ClientFlow er backend-godkendt og automatisk aktiveret.")
                return 0
        _ensure_preactivation_gui_started()
        print("ClientFlow afventer backend-godkendelse; prøver igen om 10 sekunder.")
        time.sleep(10)


def _factory_identity() -> tuple[str, str | None]:
    state = load_factory_state()
    if state is None:
        raise BootstrapError("Factory-state mangler. Kør 01 Klient klargøring på kontoret først.")
    if state.get("schema_version") != 2:
        raise BootstrapError("Factory-state har ukendt schema")
    if state.get("handoff_ready") is not True:
        raise BootstrapError("Factory-state er ikke valideret som klar til kundeoverdragelse")
    if state.get("kiosk_user") != KIOSK_USER or state.get("admin_user") != "cfadmin":
        raise BootstrapError("Factory-state matcher ikke canonical ClientFlow-konti")
    name = str(state.get("client_name") or "").strip()
    operator = str(state.get("operator_user") or "").strip() or None
    if not name:
        raise BootstrapError("Factory-state mangler klientnavn")
    return name, operator


def _customer_install() -> int:
    banner("02 · Kundeaktivering · V2 · manuel desktopflow")
    phase("1/8 · Kunde-netværk")
    configure_network_interactive("kundeaktivering")

    existing = _existing_install_state()
    if existing is not None:
        phase("2/8 · Sikker genoptagelse")
        name = str(existing.get("client_name") or "").strip()
        locality_value = existing.get("locality")
        locality = str(locality_value).strip() if locality_value else None
        if not name:
            raise RuntimeError("Uafsluttet fresh install mangler klientnavn")
        factory_name, operator = _factory_identity()
        if factory_name != name:
            raise RuntimeError("Factory-state matcher ikke den uafsluttede fresh-install transaction")
        status = str(existing.get("status") or "")
        print(f"Genoptager ClientFlow-installation for: {name}")
        if status != "pending_manual_activation":
            binding = _resume_binding(existing)
            bundle = _cached_exact_bundle(binding)
            phase("4/8 · Exact release og integrity · resume")
            phase("5/8 · Backend claim og installation · resume")
            result = _run_canonical_installer(
                bundle=bundle,
                binding=binding,
                name=name,
                locality=locality,
                authorities=None,
            )
            if result != 0:
                warn(
                    "Installationen er bevaret som resumable. Åbn 02 Aktiver ClientFlow igen, når backend/netværk er klar."
                )
                return result
        refreshed = _existing_install_state()
        if not isinstance(refreshed, dict) or refreshed.get("status") != "pending_manual_activation":
            raise RuntimeError("Canonical fresh installer nåede ikke durable pending_manual_activation")
        _clear_cached_bundle()
    else:
        phase("2/8 · Klientoplysninger")
        name, operator = _factory_identity()
        print(f"Klientnavn: {name}")
        locality = prompt_locality()

        while True:
            code, binding = _interactive_bootstrap_binding()
            phase("4/8 · Exact release og integrity")
            with tempfile.TemporaryDirectory(prefix="clientflow-fresh-download.", dir="/run") as tmp:
                directory = Path(tmp)
                os.chmod(directory, 0o700)
                try:
                    downloaded = _download_exact_bundle(code, binding, directory)
                except urllib.error.HTTPError as exc:
                    detail = _http_error_detail(exc)
                    if 400 <= exc.code < 500:
                        warn(f"{detail}. Indtast en gyldig CF-kode eller kontakt administrator.")
                        continue
                    raise
                bundle = _cache_exact_bundle(downloaded, binding)

            phase("5/8 · Backend claim og installation")
            print(
                "cfadmin er allerede defineret i 01 Klient klargøring. Kundeaktiveringen spørger ikke efter "
                "lokal administratoradgangskode."
            )
            authorities = f"{code}\n{binding['authorization']}\n".encode("utf-8")
            result = _run_canonical_installer(
                bundle=bundle,
                binding=binding,
                name=name,
                locality=locality,
                authorities=authorities,
            )
            if result == FIRST_CLAIM_REJECTED_EXIT:
                _clear_cached_bundle()
                if _existing_install_state() is not None:
                    raise RuntimeError("Definite first-claim rejection efterlod uventet lokal install-state")
                warn("Backend afviste den første claim før commit. Indtast kun en ny CF-kode.")
                continue
            if result != 0:
                if _existing_install_state() is None:
                    _clear_cached_bundle()
                else:
                    warn(
                        "Installationen er bevaret som resumable. Åbn 02 Aktiver ClientFlow igen, når backend/netværk er klar."
                    )
                return result
            refreshed = _existing_install_state()
            if not isinstance(refreshed, dict) or refreshed.get("status") != "pending_manual_activation":
                raise RuntimeError("Canonical fresh installer nåede ikke durable pending_manual_activation")
            _clear_cached_bundle()
            break

    # The temporary customer-activation capability exists only until the
    # canonical installer has durably committed pending_manual_activation.
    remove_customer_activation_sudoers()
    cleanup_customer_launcher_trust_helper(KIOSK_USER)
    remove_desktop_install_icons(KIOSK_USER)
    if operator:
        remove_desktop_install_icons(operator)
    ok("Midlertidig kundeaktiveringsret og 02-ikon er fjernet efter durable pending-state.")

    phase("6/8 · Kiosk-session og lokal GUI før activation")
    _prepare_pre_activation_graphical_session()
    _install_preactivation_gui_service()

    phase("7/8 · Automatisk approval/activation")
    try:
        _install_activation_waiter()
    except Exception:
        _disable_preactivation_gui(remove_unit=True)
        raise
    ok("CF-koden er accepteret.")

    phase("8/8 · Aktivering færdig")
    ok("Aktivering færdig. Klienten kan genstartes efter bekræftelse.")
    confirmed_reboot("kundeaktivering gennemført", seconds=5)
    return 0

def main() -> int:
    if "--preactivation-gui" in sys.argv[1:]:
        if sys.argv[1:] != ["--preactivation-gui"]:
            print("--preactivation-gui kan ikke kombineres med andre argumenter", file=sys.stderr)
            return 2
        try:
            return _preactivation_gui()
        except Exception as exc:
            print(f"ClientFlow pre-activation GUI fejlede: {exc}", file=sys.stderr)
            return 1

    if "--activation-wait" in sys.argv[1:]:
        if sys.argv[1:] != ["--activation-wait"]:
            print("--activation-wait kan ikke kombineres med andre argumenter", file=sys.stderr)
            return 2
        try:
            return _activation_wait()
        except Exception as exc:
            print(f"ClientFlow automatic activation waiter fejlede: {exc}", file=sys.stderr)
            return 1

    if os.geteuid() != 0:
        print("Aktiver ClientFlow skal køres med administratorrettigheder.", file=sys.stderr)
        return 2
    try:
        existing = _existing_install_state()
        if existing is not None and load_factory_state() is not None:
            if str(existing.get("status") or "") == "activated":
                _cleanup_completed_bootstrap()
                print("ClientFlow er allerede aktiveret.")
                return 0
            # A legacy-compatible product install must always resume through the
            # customer orchestrator so a crash after durable pending state cannot
            # bypass the approval waiter or the operator-confirmed reboot.
            return _customer_install()
        if existing is not None:
            activation_result = _activate_pending(existing)
            if activation_result is not None:
                return activation_result
    except Exception as exc:
        print(f"ClientFlow activation check fejlede: {exc}", file=sys.stderr)
        return 1

    try:
        return _customer_install()
    except urllib.error.HTTPError as exc:
        print(_http_error_detail(exc), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nAfbrudt.", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"ClientFlow fresh install fejlede: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
