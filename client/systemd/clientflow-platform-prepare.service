[Unit]
Description=ClientFlow Ubuntu 26.04 host platform preparation
After=local-fs.target network-online.target
Wants=network-online.target
Before=clientflow.target clientflow-livestream-producer.service clientflow-remote-desktop-capture.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-platform-prepare
UMask=0022
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=no
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
