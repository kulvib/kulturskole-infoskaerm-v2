[Unit]
Description=ClientFlow generation-aware livestream uploader
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/clientflow/credentials/livestream.json

[Service]
Type=simple
User=clientflow-livestream-uploader
Group=clientflow-livestream-control
SupplementaryGroups=clientflow-livestream-control
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-livestream-uploader
Restart=on-failure
RestartSec=5s
LoadCredential=livestream.json:/etc/clientflow/credentials/livestream.json
StateDirectory=clientflow/livestream-uploader
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=clientflow.target
