[Unit]
Description=ClientFlow optional kiosk lockdown fixed-function broker

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-kiosk-lockdown-broker
LoadCredential=identity.json:/etc/clientflow/identity.json
Environment=CLIENTFLOW_IDENTITY_FILE=%d/identity.json
StateDirectory=clientflow/kiosk-lockdown
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=no
ProtectHome=read-only
ReadWritePaths=/home/clientflow-kiosk
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
