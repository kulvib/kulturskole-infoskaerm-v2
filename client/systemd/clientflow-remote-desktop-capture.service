[Unit]
Description=ClientFlow Remote Desktop local capture helper
After=graphical.target

[Service]
Type=simple
User=@CLIENTFLOW_KIOSK_USER@
Group=@CLIENTFLOW_KIOSK_USER@
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-remote-desktop-capture
LoadCredential=remote-desktop.json:/etc/clientflow/remote-desktop.json
Environment=CLIENTFLOW_REMOTE_DESKTOP_CONFIG=%d/remote-desktop.json
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
