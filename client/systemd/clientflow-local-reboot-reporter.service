[Unit]
Description=ClientFlow local reboot attribution marker
DefaultDependencies=no
Before=reboot.target
ConditionPathExists=/opt/clientflow/active/runtime/bin/clientflow-power-event-marker

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-power-event-marker reboot
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
ReadWritePaths=/var/lib/clientflow/power-events
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=reboot.target
