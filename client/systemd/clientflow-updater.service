[Unit]
Description=ClientFlow stable release updater
After=network-online.target
Wants=network-online.target
OnSuccess=clientflow-update-controller.service
ConditionPathExists=/etc/clientflow/update/credential.json
ConditionPathExists=/etc/clientflow/update/private-key.pem
ConditionPathExists=/opt/clientflow/active

[Service]
Type=oneshot
User=clientflow-updater
Group=clientflow-updater
ExecStart=/usr/bin/python3 -I /usr/lib/clientflow/updater/clientflow-updater.pyz
LoadCredential=update-credential.json:/etc/clientflow/update/credential.json
LoadCredential=update-private-key.pem:/etc/clientflow/update/private-key.pem
LoadCredential=update-ca.pem:/etc/clientflow/update/tls-ca.pem
Environment=CLIENTFLOW_UPDATE_CA_FILE=%d/update-ca.pem
StateDirectory=clientflow/updater
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
