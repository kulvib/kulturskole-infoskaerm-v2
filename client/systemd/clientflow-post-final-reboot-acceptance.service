[Unit]
Description=ClientFlow post-final-reboot customer handoff acceptance
After=graphical.target clientflow-display-runtime.service clientflow-kiosk-lockdown-broker.socket
Wants=graphical.target clientflow-display-runtime.service clientflow-kiosk-lockdown-broker.socket
ConditionPathExists=/var/lib/clientflow/release/customer-handoff.json
StartLimitIntervalSec=300
StartLimitBurst=18

[Service]
Type=oneshot
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-post-final-reboot-acceptance
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=clientflow.target
