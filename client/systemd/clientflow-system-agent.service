[Unit]
Description=ClientFlow privileged system command agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/clientflow/credentials/system.json

[Service]
Type=simple
User=clientflow-system-agent
Group=clientflow-system-agent
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-system-agent
Restart=on-failure
RestartSec=5s
LoadCredential=system.json:/etc/clientflow/credentials/system.json
StateDirectory=clientflow/system-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=clientflow.target
